# Optional private hostnames/IPs for previewing the dev server from a phone.
# Use hostnames only, without http:// or a port. Keep this an explicit list.
# OPEN_INVITE_DEV_HOSTS=YOUR_TAILSCALE_IP

# No credentials are needed for npm run dev. Data is stored in .data/ locally.
# Production is deliberately disabled until hosted storage and authentication exist.
# To preview a production build locally only, opt in explicitly:
# OPEN_INVITE_LOCAL_DEMO=true

# Optional real extraction in the local text simulator. Otherwise use the example parser.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini

# Future hosted integration. These do not switch the local app to cloud mode.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
