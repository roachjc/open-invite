{
  "name": "open-invite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.production --env-file-if-exists=.env.local --env-file-if-exists=.env.production.local ./dist/server/entry.mjs",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests supabase *.ts *.mjs README.md"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.11",
    "astro": "^7.4.7",
    "lucide": "^1.70.0",
    "luxon": "^3.7.2",
    "openai": "^7.45.0",
    "twilio": "^6.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ]
  }
}
