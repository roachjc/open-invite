# Hosted production configuration contract. Wiring is still required; see docs/SETUP.md.
# All values must belong to production resources, not QC.
OPEN_INVITE_ENV=production
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Enable only after the production sender, consent flow, and delivery worker are ready.
OPEN_INVITE_LIVE_SMS=false
# Keep OPEN_INVITE_LOCAL_DEMO unset in hosted environments.
