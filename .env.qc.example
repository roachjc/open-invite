# Hosted QC configuration contract. Wiring is still required; see docs/SETUP.md.
# Copy real values into the QC Vercel project and relevant QC worker settings.
OPEN_INVITE_ENV=qc
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OPEN_INVITE_LIVE_SMS=false
# Comma-separated opted-in QC numbers in international format. Enforcement is planned.
QC_SMS_ALLOWLIST=
# Keep OPEN_INVITE_LOCAL_DEMO unset in hosted environments.
