---
import Shell from "@/layouts/Shell.astro";
import Notifications from "@/components/Notifications.astro";
import { loadApp, readForm } from "@/lib/server/app";
import { finish } from "@/lib/server/respond";
import { identity } from "@/lib/server/http";
import { getStore } from "@/lib/server/database";

if (Astro.request.method === "POST") {
  const data = await readForm(Astro);
  const enabled = data.has("enabled");
  getStore().setNotificationPreferences(identity(Astro.cookies), { enabled });
  return finish(
    Astro,
    "/notifications",
    enabled
      ? "Text notifications turned on."
      : "Text notifications turned off.",
  );
}
const app = loadApp(Astro);
---

<Shell
  app={app}
  view="notifications"
  title="Notifications"
  home="/notifications"
>
  <Notifications app={app} />
</Shell>
